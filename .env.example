# ==============================================================================
# RAPIOT LIVE MONITOR - BACKEND ENVIRONMENT CONFIGURATION (UBUNTU VPS)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS allowed origin: For local development from Windows laptop, allow http://localhost:5173
# For production web hosting, change to your domain: e.g. https://monitor.yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Security Token for API Output Actuation (DO1 / DO2)
API_SECRET_TOKEN=rapiot_secure_super_secret_token_change_in_production

# MQTT Broker (Mosquitto running locally on this Ubuntu VPS)
# Because backend and Mosquitto are on the same VPS, use 127.0.0.1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=rapiot-mqtt
MQTT_PASSWORD=#Rapiot@3102
MQTT_CLIENT_ID=rapiot_dashboard_backend

# MQTT Topic Configuration (Supports wildcards e.g. rapiot/+/telemetry)
MQTT_TOPIC_TELEMETRY=rapiot/+/telemetry
MQTT_TOPIC_STATUS=rapiot/+/status
MQTT_TOPIC_COMMAND=rapiot/+/command
MQTT_TOPIC_COMMAND_ACK=rapiot/+/command/ack

# Primary Device Configuration & Allowed Device IDs
DEVICE_ID=RAPIOT_1
ALLOWED_DEVICE_IDS=RAPIOT_1,RAPIOT_2
DEVICE_TIMEOUT_SECONDS=15

# Development Mode: Set to false when connecting to the real device & broker!
DEMO_MODE=false
DEMO_INTERVAL_MS=3000

# Telemetry Field Mapping (Can be adjusted without touching source code)
PAYLOAD_MAP_DEVICE_ID=deviceId
PAYLOAD_MAP_AI1=AI1
PAYLOAD_MAP_AI2=AI2
PAYLOAD_MAP_DI1=DI1
PAYLOAD_MAP_DI2=DI2
PAYLOAD_MAP_DO1=DO1
PAYLOAD_MAP_DO2=DO2
PAYLOAD_MAP_TIMESTAMP=timestamp
PAYLOAD_MAP_UPTIME=networkUptime

# Output Command Control
COMMAND_CONTROL_ENABLED=true
DO1_ON_PAYLOAD={"output":1,"state":1}
DO1_OFF_PAYLOAD={"output":1,"state":0}
DO2_ON_PAYLOAD={"output":2,"state":1}
DO2_OFF_PAYLOAD={"output":2,"state":0}
COMMAND_ACK_TIMEOUT_MS=5000
